{
  "name": "swiss-knife",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "A 100% client-side developer toolkit running entirely in your browser with zero network access. No data ever leaves your device.",
  "main": "src/index.js",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "bun --bun webpack serve --mode development --open",
    "build": "bun run build:web && bun run build:offline",
    "build:web": "bun --bun webpack --mode production",
    "build:offline": "bun --bun webpack --config webpack.offline.config.js",
    "postbuild": "bun scripts/generateFavicons.js && bun scripts/compress.js"
  },
  "dependencies": {
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@eslint-community/regexpp": "4.12.2",
    "@uiw/react-codemirror": "^4.25.11",
    "base-x": "^5.0.1",
    "bcryptjs": "^3.0.3",
    "blakejs": "^1.2.1",
    "buffer": "^6.0.3",
    "bwip-js": "^4.11.2",
    "crypto-js": "^4.2.0",
    "jsrsasign": "^11.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "archiver": "^8.0.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.4",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.1",
    "sharp": "^0.35.3",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.109.0",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
