{
  "name": "swiss-knife",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "A 100% client-side developer toolkit running entirely in your browser with zero network access. No data ever leaves your device.",
  "main": "src/index.js",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "bun scripts/bun-dev.js",
    "build": "bun run build:web && bun run build:offline",
    "build:web": "bun scripts/bun-build.js web",
    "build:offline": "bun scripts/bun-build.js offline",
    "postbuild": "bun scripts/generateFavicons.js && bun scripts/compress.js"
  },
  "dependencies": {
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@eslint-community/regexpp": "4.12.2",
    "@uiw/react-codemirror": "^4.25.11",
    "base-x": "^5.0.1",
    "bcryptjs": "^3.0.3",
    "blakejs": "^1.2.1",
    "bwip-js": "^4.11.2",
    "crypto-js": "^4.2.0",
    "jsrsasign": "^11.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "archiver": "^8.0.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  }
}
